# Copy to .env and fill in. .env is gitignored: never commit real secrets.

# ---- providers (defaults run fully offline) --------------------------------
RAG_EMBEDDING_PROVIDER=hashing      # hashing | local | vertex | openai | ollama
RAG_LLM_PROVIDER=offline            # offline | vertex | openai | ollama
# RAG_EMBEDDING_MODEL=text-embedding-005
# RAG_LLM_MODEL=gemini-2.5-flash

# ---- vector store ------------------------------------------------------------
RAG_VECTOR_STORE=memory             # memory | postgres
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/retail
# Cloud Run + Cloud SQL (unix socket):
# RAG_DATABASE_URL=postgresql://USER:PASSWORD@/retail?host=/cloudsql/PROJECT:REGION:INSTANCE

# ---- Vertex AI (uses Application Default Credentials: gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- OpenAI ------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---- Ollama (docker compose --profile ollama up, then: ollama pull llama3.2 nomic-embed-text)
# OLLAMA_BASE_URL=http://localhost:11434

# ---- API -----------------------------------------------------------------------
# RAG_API_KEY=change-me             # when set, /v1/* requires header X-API-Key
RAG_LOG_JSON=true
